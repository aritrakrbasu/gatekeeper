# Backend base configuration
PORT=8000
FRONTEND_URL=https://your-project.vercel.app
GATEKEEPER_WEBHOOK_URL=https://your-backend-domain/webhooks/gitlab
GITLAB_REDIRECT_URI=https://your-project.vercel.app/auth/callback
GITLAB_BASE_URL=https://gitlab.com

# Backend auth and storage secrets
SECRET_KEY=replace-with-a-long-random-secret
GITLAB_CLIENT_ID=replace-with-gitlab-oauth-client-id
GITLAB_CLIENT_SECRET=replace-with-gitlab-oauth-client-secret
GITLAB_PERSONAL_ACCESS_TOKEN=replace-with-service-token-if-needed
MDB_MCP_CONNECTION_STRING=replace-with-mongodb-connection-string
GATEKEEPER_ENCRYPTION_KEY=replace-with-32-char-secret

# Observability
ARIZE_SPACE_ID=
ARIZE_API_KEY=
PHOENIX_MODE=cloud
PHOENIX_API_KEY=
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_PROJECT_NAME=gatekeeper
ENABLE_EVALUATIONS=true
ENABLE_SELF_IMPROVEMENT=true

# Optional Fivetran settings
FIVETRAN_MCP_ENABLED=false
FIVETRAN_BASE_URL=https://api.fivetran.com/v1
FIVETRAN_EXECUTION_MODE=dry_run
