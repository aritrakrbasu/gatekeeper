# MongoDB MCP Connection
MDB_MCP_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# Application Port
PORT=8000

# Frontend URL for CORS (allow your frontend to make API requests)
FRONTEND_URL=http://localhost:3000
PORT=8000

# GitLab Personal Access Token for webhook authentication
GITLAB_PERSONAL_ACCESS_TOKEN=glpat_xxxxxxxxxxxxxxxxxxxxxx

# Gatekeeper Webhook URL (where GitLab will send MR events)
# For local development with automatic localtunnel setup, run:
#   npm run dev:tunnel
# This will start a tunnel and auto-update this value in your .env file
GATEKEEPER_WEBHOOK_URL=http://localhost:8000/webhooks/gitlab

# ==============================================================================
# GitLab OAuth Configuration for Frontend Authentication
# Get credentials from: https://gitlab.com/-/profile/applications
# ==============================================================================
GITLAB_CLIENT_ID=your_gitlab_application_id_here
GITLAB_CLIENT_SECRET=your_gitlab_application_secret_here
GITLAB_REDIRECT_URI=http://localhost:3000/auth/callback
GITLAB_BASE_URL=https://gitlab.com

# Secret key for JWT token generation (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_secret_key_here

# Google Gemini API Key for AI code review
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# Arize AI Observability Configuration
# Get your keys from https://app.arize.com/organizations/-/settings/space-api-keys
# ==============================================================================
ARIZE_SPACE_ID=your_space_id_here
ARIZE_API_KEY=your_api_key_here

# ==============================================================================
# Phoenix Configuration for Hackathon
# ==============================================================================
# Phoenix deployment mode: 'cloud' or 'self-hosted'
PHOENIX_MODE=cloud

# Phoenix Cloud API Key (get from https://app.phoenix.arize.com)
PHOENIX_API_KEY=your_phoenix_api_key_here

# Phoenix Base URL
# Cloud: https://app.phoenix.arize.com
# Self-hosted: http://localhost:6006
PHOENIX_BASE_URL=https://app.phoenix.arize.com

# Phoenix Project Name (for grouping evaluations in the Evaluations tab)
PHOENIX_PROJECT_NAME=gatekeeper

# ==============================================================================
# Evaluation & Self-Improvement Configuration
# ==============================================================================
# Enable automatic LLM-as-a-Judge evaluations
ENABLE_EVALUATIONS=true

# Enable self-improvement loop (agent learns from its reviews)
ENABLE_SELF_IMPROVEMENT=true

# Judge model for LLM-as-a-Judge evaluations
JUDGE_MODEL=gemini-3-flash-preview

# Evaluation criteria (comma-separated)
EVALUATION_CRITERIA=security,quality,actionability,clarity

# Enable prompt versioning
PROMPT_VERSIONING_ENABLED=true

# Enable experiment tracking
EXPERIMENT_TRACKING_ENABLED=true

# ==============================================================================
# Arize AX (Prompt Management) Configuration
# ==============================================================================
# Arize Space ID (from https://app.arize.com/organizations/-/settings)
# Required for prompt retrieval via SDK
ARIZE_SPACE_ID=your_space_id_here

# Arize AX prompt label to fetch (e.g., "production", "staging")
# Optional - if not set, will fetch the latest version
# Uses labels to decouple code from version IDs
# ARIZE_AX_PROMPT_LABEL=production

# Default prompt ID for MR review system
ARIZE_AX_PROMPT_ID=senior_pr_reviewer_v1
